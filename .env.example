# Copy to .env.local for local development (.env* is gitignored).
# In production these come from the k8s deployment env + the
# veranafoundation-website-secrets Secret (token injected by CI from the
# RELATICLE_API_TOKEN GitHub Actions secret) — do NOT ship a .env file.

# ─── Analytics (public) ──────────────────────────────────────────────────────
# Google Analytics 4 measurement ID. NEXT_PUBLIC_* is inlined at build time and
# exposed to the browser. Defaults to the shared Verana property (G-9H5406F02W)
# when unset; override for a staging/preview property, or set empty to disable
# analytics entirely. The tag is consent-gated — it loads only after a visitor
# selects "Accept all" in the cookie banner (see app/components/Analytics.tsx).
NEXT_PUBLIC_GA_ID=G-9H5406F02W

# Relaticle CRM — the contact form posts inquiries here.
# Locally you can point at the public instance; in-cluster the deployment uses
# http://relaticle.relaticle.svc.cluster.local
RELATICLE_API_URL=https://crm.2060.io
RELATICLE_API_TOKEN=

# Optional: Discord/Slack-compatible webhook for best-effort ops alerts when a
# CRM write fails. Leave empty to log to stderr only.
ALERT_WEBHOOK_URL=

# ─── Membership / billing / accounts ────────────────────────────────────────
# In production ALL of these come from GitHub Actions secrets, injected by CI
# into the veranafoundation-website-secrets Secret (see docker-publish.yml).
# Never commit real values — this file holds placeholder keys only.

# Postgres. Local dev points at the docker/ compose Postgres (npm run db:up).
# In production CI derives this
# from POSTGRES_PASSWORD (host/user/db are fixed in k8s/postgres.yaml), so
# DATABASE_URL is NOT a separate prod secret.
DATABASE_URL=postgresql://verana:verana@localhost:5432/verana?schema=public

# Auth.js (NextAuth v5). AUTH_SECRET: generate with `openssl rand -base64 32`.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# OAuth providers (verified-email sign-in). Create apps in Google / GitHub.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Transactional email over SMTP (magic links, executed-agreement copy).
# Gmail/Workspace needs an App Password — enable 2FA on the account, then create
# one at https://myaccount.google.com/apppasswords (the raw account password
# won't work). MAIL_PORT 587 = STARTTLS, 465 = SSL (or set MAIL_ENCRYPTION=ssl).
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=you@veranafoundation.org
MAIL_PASSWORD=
MAIL_ENCRYPTION=
MAIL_FROM_ADDRESS=no-reply@veranafoundation.org
MAIL_FROM_NAME=Verana Foundation
# Optional: absolute URL of a hosted raster (PNG) Verana logo for email headers.
# Unset → a styled text wordmark is used (SVG/remote images render unreliably in
# many email clients, so prefer a small PNG if you set this). The site ships one
# at /assets/img/email-logo.png (428x56, displayed at 28px high); production
# sets https://veranafoundation.org/assets/img/email-logo.png.
EMAIL_LOGO_URL=

# Stripe Checkout (Associate dues; /pay/{invoiceId}). Webhook secret for
# /api/webhooks/stripe (checkout.session.completed / async_payment_succeeded).
# STRIPE_BANK_TRANSFER=on adds Stripe's own bank-transfer method to Checkout —
# leave off: Stripe prohibits that feature for "membership organizations" (this
# account's category); bank payers wire directly (BANK_TRANSFER_DETAILS).
# STRIPE_BANK_TRANSFER_COUNTRY: where Stripe domiciles the virtual IBAN
# (BE/DE/ES/FR/IE/NL; not EE) when the feature is on.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BANK_TRANSFER=off
STRIPE_BANK_TRANSFER_COUNTRY=DE

# Invoicing entity for Associate dues + VAT. VAT_DOMESTIC_RATE: CONFIRM the
# Estonian rate + the Foundation/2060 OÜ VAT registration with the accountant.
SELLER_LEGAL_NAME=
SELLER_COUNTRY=EE
SELLER_VAT_NUMBER=
INVOICE_PREFIX=VF-
VAT_DOMESTIC_RATE=0.24

# Bank details for paying dues by direct wire (free text: beneficiary, IBAN,
# BIC…), shown in the payment-request email and on the billing page. Use the
# Wise Business EUR account; members reference the invoice number.
BANK_TRANSFER_DETAILS=

# Wise Business API (read-only) — auto-reconciles direct wires via the
# activities feed + transfer lookups (the statement endpoint is closed: Wise
# retired signature SCA for personal tokens under PSD2; no SCA key needed).
# WISE_WEBHOOK_PUBLIC_KEY: Wise's published webhook-signing public key (per
# environment) for /api/webhooks/wise (`balances#credit`). CRON_SECRET guards
# the /api/cron/wise-reconcile backstop. WISE_API_URL: set to
# https://api.sandbox.transferwise.tech for sandbox.
WISE_API_TOKEN=
WISE_PROFILE_ID=
WISE_WEBHOOK_PUBLIC_KEY=
WISE_API_URL=
WISE_RECONCILE_DAYS=14
CRON_SECRET=

# Filesystem storage for member-generated files (signed agreement PDFs, future
# org logos). In production this is a mounted PVC at /data (see k8s/deployment.yaml);
# locally it defaults to ./var/storage when unset.
STORAGE_DIR=

# Bootstrap admin emails (comma-separated) seeded into the admin allowlist on
# first run. After bootstrap, admins are managed in /admin/admins.
ADMIN_BOOTSTRAP_EMAILS=

# Optional: which legal/ version file the seed activates as the Membership
# Agreement (admins can switch versions in /admin/settings). Defaults to
# membership-agreement-v1.md.
AGREEMENT_FILENAME=membership-agreement-v1.md

# ── Working groups (ADR-0003) ────────────────────────────────────────────────
# Google Calendar sync: a service account with domain-wide delegation
# (scope https://www.googleapis.com/auth/calendar.events) impersonates the
# meetings role account, which organizes every WG meeting (auto Meet links,
# native invitations). Schedules still save without this; sync is retried.
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
GOOGLE_CALENDAR_IMPERSONATE=meetings@verana.io

# Public minutes repository: published session notes are committed to
# <wg-slug>/minutes/YYYY-MM-DD.md. Fine-grained PAT, Contents read/write on
# this single repo.
MINUTES_REPO=verana-labs/working-groups
MINUTES_GITHUB_TOKEN=

# Optional: raises the GitHub API rate limit for the home-page org statistics
# (contributor wall). When unset, MINUTES_GITHUB_TOKEN is used as fallback;
# with neither, the anonymous 60/hr limit applies and the home shows a static
# fallback when exceeded.
GITHUB_TOKEN=

# Blog: the /blog pages render Markdown posts fetched from a public GitHub repo
# (the source of truth), with ISR (hourly). Defaults shown; all configurable.
# Auth falls back to BLOG_GITHUB_TOKEN -> MINUTES_GITHUB_TOKEN (raises rate limit;
# a token is optional for public repos). The page renders empty if unreachable.
BLOG_REPO=verana-labs/social-posts
BLOG_PATH=veranafoundation.org/blog
BLOG_BRANCH=main
BLOG_GITHUB_TOKEN=
