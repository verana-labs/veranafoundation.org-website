// Verana Foundation — membership, billing & accounts
// Implements the data model in docs/: ADR-0002 (auth/roles/access),
// verana-invoicing-spec (memberships/invoices/agreement), ADR-0001 (entitlements/seller).
//
// Conventions: cuid() ids, UTC DateTimes, explicit enums for closed sets.

generator client {
  provider      = "prisma-client-js"
  // "native" for local dev; the musl/openssl-3 target is for the node:22-alpine runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// Auth.js (NextAuth v5) standard models — field names are required by the adapter
// ─────────────────────────────────────────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String? // provider-supplied; refreshed on OAuth sign-in
  displayName   String? // user-chosen (ADR-0003); never touched by providers
  email         String?   @unique // the verified email is the identity key (ADR-0002)
  emailVerified DateTime?
  image         String?

  accounts         Account[]
  sessions         Session[]
  memberships      UserMember[] // orgs/individuals this user can act for
  adminActions     AdminAction[]
  notifications    Notification[]
  wgLeads          WgLead[]
  wgParticipations WgParticipant[]
  wgSessions       WgSession[] // sessions this user recorded

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  wgJoinRequests WgJoinRequest[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String // "google" | "github" | "email" (magic link)
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String // email magic-link / OTP
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ─────────────────────────────────────────────────────────────────────────────
// Foundation admin allowlist (ADR-0002) — the only grant of Foundation-admin rights
// ─────────────────────────────────────────────────────────────────────────────

model AdminAllowlistEntry {
  id            String   @id @default(cuid())
  email         String   @unique // verified email granted `admin`
  addedByUserId String?
  addedAt       DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────────────────────
// Members (contracting party) — org or individual
// ─────────────────────────────────────────────────────────────────────────────

model Member {
  id   String     @id @default(cuid())
  type MemberType

  legalName String

  // organization-only
  entityType         String?
  jurisdiction       String?
  registeredAddress  String?
  noticeBillingEmail String?
  logoUri            String? // storage key of the uploaded logo (logos/{id}.{ext}); future homepage display

  // individual-only
  countryOfResidence String?

  // consent
  socialAnnouncementConsent Boolean @default(false) // ok to announce their membership on our social networks
  logoDisplayConsent        Boolean @default(false) // ok to display the logo on veranafoundation.org (asked at upload)

  // billing / tax
  primaryEmail     String
  vatNumber        String?
  vatStatus        VatStatus @default(none)
  stripeCustomerId String?

  // One membership per member: a Member is the durable party; its single
  // Membership is the current subscription term, renewed in place (periodEnd
  // extended), reactivated on re-join. Per-period billing history lives in
  // Invoice; change history in AdminAction.
  membership       Membership?
  access           MemberAccess[]
  userLinks        UserMember[]
  signatureRecords SignatureRecord[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Membership {
  id       String @id @default(cuid())
  memberId String @unique // one membership per member (1:1)
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  class  MembershipClass
  tier   String? // Associate only — e.g. "tier_3" (Annex D bands); dues resolved in code
  status MembershipStatus @default(pending)
  listed Boolean          @default(false) // admin-curated: shown on the public /members page

  periodStart DateTime?
  periodEnd   DateTime?

  invoices Invoice[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
}

// Who can act for a Member, and how. Derived from MemberAccess on first verified login.
model UserMember {
  id       String     @id @default(cuid())
  userId   String
  memberId String
  role     MemberRole

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, memberId])
  @@index([memberId])
}

// Org-managed email allowlist (ADR-0002). Admins (`manager`) maintain both lists.
model MemberAccess {
  id            String       @id @default(cuid())
  memberId      String
  member        Member       @relation(fields: [memberId], references: [id], onDelete: Cascade)
  email         String
  role          MemberRole
  status        AccessStatus @default(invited)
  addedByUserId String?
  addedAt       DateTime     @default(now())

  @@unique([memberId, email])
  @@index([email])
}

// ─────────────────────────────────────────────────────────────────────────────
// Billing (ADR-0001 + invoicing spec)
// ─────────────────────────────────────────────────────────────────────────────

// One invoicing entity for now (the Foundation / 2060 OÜ). Centralizes VAT + branding.
model SellerEntity {
  id               String  @id @default(cuid())
  legalName        String
  vatNumber        String?
  country          String // "EE"
  address          String?
  invoicePrefix    String // "VF-"
  // provider account refs (e.g. { "stripe": "acct_..." })
  providerAccounts Json?

  invoices Invoice[]
}

model Invoice {
  id             String       @id @default(cuid())
  membershipId   String
  membership     Membership   @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  sellerEntityId String
  sellerEntity   SellerEntity @relation(fields: [sellerEntityId], references: [id])

  number   String @unique // e.g. "VF-2026-0001"
  currency String @default("EUR")

  netAmount   Int // minor units (cents)
  vatAmount   Int @default(0)
  grossAmount Int

  vatTreatment       VatTreatment
  status             InvoiceStatus @default(draft)
  payMethod          PayMethod?
  providerRef        String? // Stripe invoice id, etc.
  // Which fee schedule priced this invoice (audit; null on legacy rows).
  feeScheduleVersion String?

  dueDate  DateTime?
  issuedAt DateTime?
  paidAt   DateTime?

  payments Payment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([membershipId])
  @@index([status])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  provider    String // "stripe" | "offline_bank_transfer"
  providerRef String?
  amount      Int // minor units
  currency    String   @default("EUR")
  receivedAt  DateTime @default(now())
  raw         Json? // raw provider payload for audit

  @@index([invoiceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Membership Agreement (admin-configurable PDF) + e-signature record
// ─────────────────────────────────────────────────────────────────────────────

// Catalog of agreement template versions. One row per version file in legal/.
// The hash is pinned at first activation: a filename, once activated, is bound to
// that hash forever, so members who signed "vN" can trust it never changed.
model AgreementDocument {
  id            String   @id @default(cuid())
  filename      String   @unique // version file in legal/, e.g. "membership-agreement-v1.md"
  version       String // label derived from filename, e.g. "v1"
  hash          String // pinned sha384 of the file, SRI form ("sha384-…")
  hashAlgo      String   @default("sha384")
  active        Boolean  @default(false)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
}

model SignatureRecord {
  id       String @id @default(cuid())
  memberId String
  member   Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  signerName    String
  signerTitle   String?
  emailVerified Boolean @default(false)

  // the AgreementDocument that was accepted (snapshot — survives later config changes)
  agreementVersion String
  agreementUrl     String
  agreementHash    String? // sha256 of the signed PDF

  // Storage key (path under STORAGE_DIR volume) of the exact personalised PDF
  // that was signed, kept verbatim so the member can re-download it and so later
  // template edits never alter a signed copy.
  agreementPdfPath String?

  signedAt  DateTime @default(now())
  ip        String?
  userAgent String?

  @@index([memberId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Working Groups (ADR-0002) — admin-managed; access is computed, not stored
// ─────────────────────────────────────────────────────────────────────────────

model WorkingGroup {
  id            String            @id @default(cuid())
  slug          String            @unique // URL + minutes-repo folder name (ADR-0003)
  name          String
  description   String?
  requiredClass RequiredClass     @default(any)
  link          String // external URL to the WG's space
  showOnHome    Boolean           @default(false) // featured on the public home page
  state         WorkingGroupState @default(enabled) // disabled = hidden from public pages
  priority      Int               @default(0) // higher shows first in public listings
  disabledAt    DateTime? // when state last became disabled (admin grace window)

  // ADR-0004: Meet auto-transcription → AI-drafted minutes, reviewed by a lead.
  autoMinutes Boolean      @default(true)
  // The group's working language (BCP 47): what it writes in, and the language
  // of the drafted minutes. Regional groups (e.g. Latin America, in Spanish)
  // pair it with a region; both are badges and filters on the board.
  language    String       @default("en")
  region      WgRegion     @default(global)
  // Private groups (admin-set): listed with the schedule, but participants,
  // sessions and transcripts are members-only and joining needs a lead's
  // approval (WgJoinRequest). Their minutes publish to the private repo.
  visibility  WgVisibility @default(public)

  leads        WgLead[]
  participants WgParticipant[]
  invites      WgInvite[]
  joinRequests WgJoinRequest[]
  schedule     WgSchedule?
  sessions     WgSession[]
  transcripts  WgTranscript[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum WorkingGroupState {
  enabled
  disabled
}

enum WgVisibility {
  public
  private
}

enum WgRegion {
  global
  europe
  latin_america
  north_america
  africa
  asia_pacific
}

// ─────────────────────────────────────────────────────────────────────────────
// Working Group leads / participants / schedule / sessions (ADR-0003)
// ─────────────────────────────────────────────────────────────────────────────

// Leads run the group. Invariant (enforced in actions): never zero leads.
model WgLead {
  id            String       @id @default(cuid())
  wgId          String
  wg            WorkingGroup @relation(fields: [wgId], references: [id], onDelete: Cascade)
  userId        String
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  addedByUserId String?
  createdAt     DateTime     @default(now())

  @@unique([wgId, userId])
  @@index([userId])
}

// Explicit membership in a WG: who gets Calendar invites and appears in the
// attendance picker. Access is still re-checked against canAccessWg per request.
model WgParticipant {
  id       String       @id @default(cuid())
  wgId     String
  wg       WorkingGroup @relation(fields: [wgId], references: [id], onDelete: Cascade)
  userId   String
  user     User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt DateTime     @default(now())
  leftAt   DateTime?

  @@unique([wgId, userId])
  @@index([userId])
}

// An email invited into a WG (as lead or participant) by an admin or a lead —
// possibly before any account or membership exists. The invite converts into a
// WgLead/WgParticipant row only once a user with that verified email holds an
// active membership satisfying the group's requiredClass (strict gate); until
// then the person is nudged by email to join the Foundation. Pending = null
// acceptedAt; revocation deletes the row (audited in AdminAction).
model WgInvite {
  id              String       @id @default(cuid())
  wgId            String
  wg              WorkingGroup @relation(fields: [wgId], references: [id], onDelete: Cascade)
  email           String // lowercased verified-email key (ADR-0002)
  role            WgInviteRole
  invitedByUserId String?
  createdAt       DateTime     @default(now())
  acceptedAt      DateTime? // set when converted into a lead/participant row

  @@unique([wgId, email])
  @@index([email])
}

enum WgInviteRole {
  lead
  participant
}

// A member asking to join a private group; a lead approves (→ WgParticipant)
// or declines. One live row per (group, user): re-requesting after a decline
// resets it to pending.
model WgJoinRequest {
  id              String              @id @default(cuid())
  wgId            String
  wg              WorkingGroup        @relation(fields: [wgId], references: [id], onDelete: Cascade)
  userId          String
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  message         String?
  status          WgJoinRequestStatus @default(pending)
  decidedByUserId String?
  decidedAt       DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  @@unique([wgId, userId])
  @@index([wgId, status])
}

enum WgJoinRequestStatus {
  pending
  approved
  declined
}

// One recurring meeting series per WG. The DB is canonical; Google Calendar is
// the delivery rail (event on the meetings@ role account, one-way DB→Google).
model WgSchedule {
  id          String       @id @default(cuid())
  wgId        String       @unique
  wg          WorkingGroup @relation(fields: [wgId], references: [id], onDelete: Cascade)
  startsAt    DateTime // first occurrence (DTSTART)
  durationMin Int
  timezone    String // IANA, e.g. "Europe/Paris"
  rrule       String // RFC 5545, e.g. "FREQ=WEEKLY;BYDAY=WE"

  // Google sync state — set after a successful Calendar API push.
  googleEventId String?
  meetLink      String? // auto-created Meet link, participants-only
  syncedAt      DateTime?
  syncError     String? // last push failure; UI offers retry while set

  // Google Meet space (ADR-0004, amended 2026-10-05): the site creates the
  // space itself (meetSpaceName) and attaches it to the Calendar event, so it
  // can make the leads co-hosts; meetAutoTranscribe is the setting last pushed
  // (on only around scheduled occurrences; null = never pushed).
  meetSpaceName       String? // "spaces/{space}" — null until the site owns the space
  meetingCode         String?
  meetAutoTranscribe  Boolean?
  meetConfiguredAt    DateTime?
  meetConfigError     String? // last Meet push failure; retried by the cron
  meetMembersSyncedAt DateTime? // co-host list last reconciled with the leads
  meetMembersError    String?

  exceptions WgScheduleException[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// One occurrence that differs from the series, mirrored to the Calendar
// instance: cancelled ("skip next week", movedTo null) or moved to another
// date/time (movedTo set, same duration) — e.g. around holidays.
model WgScheduleException {
  id            String     @id @default(cuid())
  scheduleId    String
  schedule      WgSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  originalStart DateTime // the occurrence's scheduled start (UTC)
  movedTo       DateTime? // the new start (UTC) when moved; null = cancelled
  note          String?
  createdAt     DateTime   @default(now())

  @@unique([scheduleId, originalStart])
}

// A meeting's record: attendance + Markdown minutes. Published minutes are
// committed to the public minutes repo; the DB copy renders the history pages.
// Since ADR-0004 only leads write sessions; the transcript pipeline may create
// one (recordedById null until a lead approves it).
model WgSession {
  id           String          @id @default(cuid())
  wgId         String
  wg           WorkingGroup    @relation(fields: [wgId], references: [id], onDelete: Cascade)
  occurredAt   DateTime
  status       WgSessionStatus @default(draft)
  source       WgSessionSource @default(manual)
  notesMd      String          @default("") @db.Text
  recordedById String?
  recordedBy   User?           @relation(fields: [recordedById], references: [id])

  // GitHub publish state (minutes repo path + commit, for the citable record)
  notesPath      String?
  notesCommitSha String?

  attendees  WgSessionAttendee[]
  transcript WgTranscript?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([wgId, occurredAt])
  @@index([wgId, status])
}

enum WgSessionSource {
  manual
  ai_draft // minutes prefilled from the Meet transcript (ADR-0004)
}

// ADR-0004: one row per meeting that Google Meet transcribed, attached to the
// session of the matching occurrence. The cron step machine advances `status`
// (lib/transcripts.ts); the DB copy of the entries is the durable one, Google
// deletes them 30 days after the conference.
model WgTranscript {
  id        String       @id @default(cuid())
  wgId      String
  wg        WorkingGroup @relation(fields: [wgId], references: [id], onDelete: Cascade)
  sessionId String       @unique
  session   WgSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  meetingCode       String
  // Meet conference records merged into this transcript: a dropped call that
  // resumes creates a second record for the same occurrence.
  conferenceRecords String[]
  startedAt         DateTime
  endedAt           DateTime?
  language          String?

  entries          Json? // TranscriptEntry[] (lib/transcripts.ts)
  entryCount       Int   @default(0)
  meetParticipants Json? // MeetAttendee[] — attendance cross-check only, never applied

  summaryMd     String?   @db.Text
  summaryModel  String?
  summarizedAt  DateTime?
  openQuestions Json? // string[] — shown to the lead, never published

  status              WgTranscriptStatus @default(awaiting_transcript)
  publishTranscript   Boolean            @default(false) // per-meeting opt-in
  transcriptPath      String?
  transcriptCommitSha String?

  lastError           String?
  attempts            Int       @default(0)
  nextAttemptAt       DateTime?
  lockedAt            DateTime?
  approvalRequestedAt DateTime?
  remindedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wgId, status])
  @@index([status, nextAttemptAt])
}

enum WgTranscriptStatus {
  awaiting_transcript // waiting for Google to generate the transcript file
  transcribed // entries persisted
  summarized // AI draft stored on the session
  awaiting_approval // leads notified
  approved // lead published the session
  discarded // lead discarded it, or no transcript was ever generated
  failed // pipeline error after retries (ops alerted)
}

// Attendance snapshot: name is frozen at recording time; guests have no userId.
model WgSessionAttendee {
  id        String    @id @default(cuid())
  sessionId String
  session   WgSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String?
  name      String

  @@index([sessionId])
}

enum WgSessionStatus {
  draft
  published
}

// ─────────────────────────────────────────────────────────────────────────────
// Audit + notifications
// ─────────────────────────────────────────────────────────────────────────────

model AdminAction {
  id          String   @id @default(cuid())
  actorUserId String?
  actor       User?    @relation(fields: [actorUserId], references: [id])
  actorEmail  String
  action      String // e.g. "invoice.void", "access.remove", "agreement.update"
  targetType  String?
  targetId    String?
  before      Json?
  after       Json?
  at          DateTime @default(now())
  ip          String?

  @@index([actorUserId])
  @@index([targetType, targetId])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String // "added_to_org" | "invoice_due" | "membership_expiring" | ...
  channel   NotificationChannel @default(in_app)
  payload   Json?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  @@index([userId, readAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────────────────────────────────────

enum MemberType {
  organization
  individual
}

enum MembershipClass {
  associate
  contributor
}

enum MembershipStatus {
  pending
  active
  past_due
  suspended
  expired
  cancelled // member left / self-cancelled (records retained)
}

enum MemberRole {
  manager // org admin: manage profile, billing, access list
  representative // WG access only
}

enum AccessStatus {
  invited // email allowlisted, no account yet
  active // linked to a signed-in user
  removed
}

enum VatStatus {
  none
  pending
  verified // VIES-valid → reverse charge eligible
  unverified
}

enum VatTreatment {
  domestic
  reverse_charge
  outside_scope
}

enum InvoiceStatus {
  draft
  issued
  paid
  void
}

enum PayMethod {
  card
  bank_transfer
}

enum RequiredClass {
  any
  associate
}

enum NotificationChannel {
  in_app
  email
}
